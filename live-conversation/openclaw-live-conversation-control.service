[Unit]
Description=OpenClaw Nemotron Live Conversation Control
After=network-online.target openclaw-gateway.service openclaw-nemo-voicechat.service
Wants=openclaw-nemo-voicechat.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/john/openclaw-android-dashboard/live-conversation
Environment=HOME=/home/john
Environment=PATH=/home/john/nodejs/bin:/home/john/node-v24.21.0-linux-x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/home/john/.openclaw/tools/pipecat-live-conversation/venv/bin/python /home/john/openclaw-android-dashboard/live-conversation/control_server.py --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/john/.openclaw/state
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=default.target
