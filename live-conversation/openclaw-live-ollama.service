[Unit]
Description=Dedicated Ollama runner for OpenClaw Live Conversation
After=network-online.target ollama.service

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11439
Environment=OLLAMA_MODELS=/usr/share/ollama/.ollama/models
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
# Use a stable UUID: CUDA ordinal 0 maps to the busy RTX 3090 on this host even
# though nvidia-smi labels the idle RTX 3080 Ti as index 0.
Environment=CUDA_VISIBLE_DEVICES=GPU-1b3fa309-4fdd-3553-0a94-47588632fec4
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
