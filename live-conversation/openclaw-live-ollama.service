[Unit]
Description=Dedicated Ollama runner for OpenClaw Live Conversation
After=network-online.target ollama.service

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11439
Environment=OLLAMA_MODELS=/usr/share/ollama/.ollama/models
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
# Reserve the voice runner on the RTX 3090; the 3080 Ti is also used by the
# general-purpose model server and cannot currently fit the full voice model.
Environment=CUDA_VISIBLE_DEVICES=GPU-635048ac-ae8d-8a51-71ef-c08275d944bd
Environment=OLLAMA_KEEP_ALIVE=-1
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
