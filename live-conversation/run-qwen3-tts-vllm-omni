#!/usr/bin/env bash
set -euo pipefail

tool_root=/home/john/.openclaw/tools/qwen3-tts-vllm-omni
venv_root="$tool_root/venv"
cuda_root="$venv_root/lib/python3.12/site-packages/nvidia/cu13"

if [[ ! -e "$cuda_root/lib/libcudart.so" && -e "$cuda_root/lib/libcudart.so.13" ]]; then
  ln -s libcudart.so.13 "$cuda_root/lib/libcudart.so"
fi

export CUDA_VISIBLE_DEVICES="${QWEN_TTS_CUDA_DEVICE:-GPU-635048ac-ae8d-8a51-71ef-c08275d944bd}"
export CUDA_HOME="$cuda_root"
export HF_HOME="${QWEN_TTS_HF_HOME:-$tool_root/hf-cache}"
export PATH="$cuda_root/bin:$venv_root/bin:$PATH"
export LD_LIBRARY_PATH="$cuda_root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBRARY_PATH="$cuda_root/lib:/usr/lib/x86_64-linux-gnu${LIBRARY_PATH:+:$LIBRARY_PATH}"

exec "$venv_root/bin/python" -m vllm.entrypoints.cli.main \
  serve Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice \
  --omni \
  --host 127.0.0.1 \
  --port 8792 \
  --trust-remote-code \
  --stage-overrides '{"0":{"max_num_seqs":1,"gpu_memory_utilization":0.23,"max_num_batched_tokens":4096,"enforce_eager":true},"1":{"max_num_seqs":1,"gpu_memory_utilization":0.23,"enforce_eager":true}}'
